# Stock Predictor Backend Environment Variables

# App
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# Database
DATABASE_URL=sqlite:///./stock_predictor.db
# For production: DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/stock_predictor

# Redis
REDIS_URL=redis://localhost:6379/0

# Market data provider (Yahoo Finance via yfinance)
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_TIMEOUT_SECONDS=30

# ML
ML_ARTIFACTS_PATH=./ml-artifacts
MODEL_RETRAIN_SCHEDULE=0 2 * * 0
PREDICTION_HORIZON_DEFAULT=5
SEQUENCE_LENGTH=30
LSTM_HIDDEN_SIZE=128
LSTM_NUM_LAYERS=2
DROPOUT=0.2

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json